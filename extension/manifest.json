{
  "manifest_version": 3,
  "name": "ORACON Auto-Fill SUNAT",
  "version": "1.1.0",
  "description": "Autocompleta el RUC, Usuario SOL y Clave SOL en el portal de la SUNAT desde el sistema ORACON en pestañas normales o ventanas de incógnito.",
  "permissions": [
    "storage",
    "activeTab",
    "windows",
    "tabs"
  ],
  "incognito": "spanning",
  "host_permissions": [
    "https://*.sunat.gob.pe/*",
    "http://*.sunat.gob.pe/*",
    "https://casillaelectronica.sunafil.gob.pe/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.oracon.com/*",
        "http://*.oracon.com/*",
        "https://*.bes.com/*",
        "http://*.bes.com/*",
        "http://192.168.*/*",
        "http://10.*/*"
      ],
      "js": ["content-bes.js"]
    },
    {
      "matches": [
        "https://*.sunat.gob.pe/*",
        "http://*.sunat.gob.pe/*"
      ],
      "js": ["content-sunat.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "ORACON Auto-Fill SUNAT"
  }
}
