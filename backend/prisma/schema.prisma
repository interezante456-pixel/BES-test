generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USUARIO_LOCAL
}

enum ModuloAcceso {
  SUNAT
  SUNAFIL
  AUDITORIA
  GESTION_USUARIOS
  GESTION_EMPRESAS
}

model Usuario {
  id                     String         @id @default(uuid())
  email                  String         @unique
  password               String
  nombres                String
  apellidos              String
  dni                    String         @unique
  rol                    Role           @default(USUARIO_LOCAL)
  modulosPermitidos      ModuloAcceso[] @default([SUNAT])
  telegramChatId         String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  
  empresas               Empresa[]
  asignaciones           EmpresaAsignacion[]
  lecturasNotificaciones NotificacionLectura[]
  auditLogs              AuditLog[]
}

enum EstadoConexion {
  CONECTADO
  REQUIERE_ACTUALIZACION
  ERROR_SISTEMA
}

model Empresa {
  id                   String         @id @default(uuid())
  ruc                  String         @unique
  razonSocial          String
  usuarioSol           String
  claveSol             String
  habilitadoSunat      Boolean        @default(true)
  habilitadoSunafil    Boolean        @default(false)
  estadoConexion       EstadoConexion @default(CONECTADO)
  estadoSincro         String         @default("IDLE")
  activo               Boolean        @default(true)
  ultimaSincronizacion DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  usuarioId      String
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  
  notificaciones Notificacion[]
  asignaciones   EmpresaAsignacion[]
}

model Notificacion {
  id                 String   @id @default(uuid())
  empresaId          String
  fileId             String?  @unique
  fechaMensaje       DateTime
  asunto             String
  tipo               String   @default("NOTIFICACION")
  rutaArchivoPdf     String?
  estado             String   @default("NO_LEIDO")
  montoExigible      String?
  expedienteCoactivo String?
  createdAt          DateTime @default(now())
  
  empresa            Empresa               @relation(fields: [empresaId], references: [id])
  lecturas           NotificacionLectura[]

  // B4: Índices compuestos para acelerar queries frecuentes del dashboard y bandeja
  @@index([empresaId, fechaMensaje])
  @@index([empresaId, estado])
  @@index([createdAt])
}


/// Tabla de lecturas por usuario — cada fila = "este usuario leyó esta notificación"
model NotificacionLectura {
  id             String       @id @default(uuid())
  notificacionId String
  usuarioId      String
  creadoAt       DateTime     @default(now())

  notificacion   Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, usuarioId])
}

model EmpresaAsignacion {
  id        String   @id @default(uuid())
  usuarioId String
  empresaId String
  creadoEn  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
}

model AuditLog {
  id        String   @id @default(uuid())
  usuarioId String?
  accion    String   // LOGIN, LOGOUT, CREAR_EMPRESA, ACTUALIZAR_EMPRESA, INICIAR_SCRAPING, DESCARGAR_PDF, LEER_NOTIF, etc.
  entidad   String?  // Empresa, Notificacion, Usuario, System
  entidadId String?
  detalles  String?  // JSON stringified con metadata relevante
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}

model ConfiguracionSistema {
  id                     String   @id @default("default")
  sincroAutomaticaActiva Boolean  @default(true)
  diasSemana             Int[]    @default([0, 1, 2, 3, 4, 5, 6]) // 0=Dom, 1=Lun, 2=Mar, 3=Mié, 4=Jue, 5=Vie, 6=Sáb
  horas                  String[] @default(["06:00", "18:00"])    // Horas en formato HH:mm (24h)
  updatedAt              DateTime @updatedAt
}

